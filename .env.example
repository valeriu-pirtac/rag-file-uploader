# ================================================
# RAG File Uploader - Environment Configuration
# ================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control

# MinIO Configuration
# -------------------
# MinIO root credentials for S3-compatible object storage
# Used for bronze-layer file storage with workspace isolation
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Redis Configuration
# -------------------
# Redis connection URL for upload session state storage
# Format: redis://[host]:[port]/[db]
REDIS_URL=redis://localhost:6379/0

# NATS Configuration
# ------------------
# NATS server URL for event publishing (FILE_LOAD_COMPLETED events)
# Format: nats://[host]:[port]
NATS_URL=nats://localhost:4222

# ClamAV Configuration
# --------------------
# ClamAV clamd service for virus scanning
# Host and port for TCP socket connection
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Application Configuration
# --------------------------
# Maximum concurrent upload sessions per service instance
MAX_CONCURRENT_UPLOADS=50

# JWT Configuration (for future authentication implementation)
# JWT public key path for token validation
# JWT_PUBLIC_KEY_PATH=/path/to/public-key.pem
