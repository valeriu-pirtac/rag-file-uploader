# ================================================
# RAG File Uploader - Environment Configuration
# ================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control

# ================================================
# Application Configuration
# ================================================

# File Upload Limits
# Maximum file size in bytes (default: 500 MB = 524_288_000 bytes, max: 1 GB)
MAX_FILE_SIZE=524288000

# Chunk size for resumable uploads in bytes (default: 25 MB = 26_214_400 bytes)
CHUNK_SIZE=26214400

# Session expiry in hours (default: 24 hours per API contract)
SESSION_TTL_HOURS=24

# Allowed MIME types (comma-separated list, default: application/pdf)
ALLOWED_MIME_TYPES=application/pdf

# Maximum concurrent upload sessions per service instance (max: 10)
MAX_CONCURRENT_UPLOADS=10

# ================================================
# Redis Configuration
# ================================================

# Redis connection URL for upload session state storage
# Format: redis://[host]:[port]/[db]
# Database must be a number 0-15
REDIS_URL=redis://localhost:6379/0

# ================================================
# MinIO/S3 Storage Configuration (REQUIRED)
# ================================================

# MinIO service endpoint (required for local development)
# Example: minio:9000 (Docker) or localhost:9000 (local)
MINIO_ENDPOINT=minio:9000

# MinIO root credentials for S3-compatible object storage
# Used for bronze-layer file storage with workspace isolation
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin

# S3 bucket name for file storage (required)
# This bucket will store all uploaded files with workspace isolation
# Must be lowercase, alphanumeric and hyphens only, 3-63 characters
S3_BUCKET_NAME=rag-data-bronze

# S3 region (default: eu-west-2 - London)
S3_REGION=eu-west-2

# Use SSL for S3 connections (default: false for local dev)
# Set to true for production S3 or MinIO with TLS configured
S3_USE_SSL=false

# ================================================
# NATS Configuration
# ================================================

# NATS server URL for event publishing (FILE_LOAD_COMPLETED events)
# Format: nats://[host]:[port]
# Required when EVENT_PUBLISH_MODE=nats
NATS_URL=nats://localhost:4222

# NATS subject for file load completed events (default: file.load.completed)
NATS_SUBJECT=file.load.completed

# Event publish mode: "nats" or "webhook" (default: nats)
# Use "nats" for JetStream event bus or "webhook" for HTTP callbacks
EVENT_PUBLISH_MODE=nats

# ================================================
# Webhook Configuration (Alternative to NATS)
# ================================================

# Webhook URL for event notifications (required if EVENT_PUBLISH_MODE=webhook)
# Must use HTTPS in production (HTTP allowed for localhost only)
# WEBHOOK_URL=https://example.com/webhook

# Webhook secret for HMAC signature verification (required if EVENT_PUBLISH_MODE=webhook)
# Minimum 32 characters recommended
# WEBHOOK_SECRET=your-webhook-secret-min-32-chars

# Webhook request timeout in seconds (default: 10)
# WEBHOOK_TIMEOUT=10

# ================================================
# ClamAV Configuration (REQUIRED)
# ================================================

# ClamAV clamd service for virus scanning
# Host and port for TCP socket connection
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ClamAV scan timeout in seconds (default: 30)
CLAMAV_TIMEOUT=30

# ================================================
# JWT Authentication Configuration (REQUIRED)
# ================================================

# RSA public key for JWT validation (RS256) - PEM format (REQUIRED)
# Required for authentication middleware
# This should be the public key corresponding to the private key used by your auth service
#
# To generate a new RSA key pair for development:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
#
# Then set JWT_PUBLIC_KEY to the contents of public_key.pem as a single line with \n for newlines:
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----
JWT_PUBLIC_KEY=

# JWT signing algorithm (default: RS256)
# Supports RS256 (RSA with SHA-256)
JWT_ALGORITHM=RS256

# ================================================
# Observability Configuration
# ================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Log format: json or console (default: json)
# Use "json" for production structured logging, "console" for development
LOG_FORMAT=json

# Enable Prometheus metrics endpoint (default: true)
METRICS_ENABLED=true

# ================================================
# Server Configuration
# ================================================

# Server bind host (default: 0.0.0.0)
# Use 0.0.0.0 to accept connections from any network interface
HOST=0.0.0.0

# Server bind port (default: 8000)
PORT=8000

# Number of worker processes (default: 1)
# Increase for production based on CPU cores available
WORKERS=1
